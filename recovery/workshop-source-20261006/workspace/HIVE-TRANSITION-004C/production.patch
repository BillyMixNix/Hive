+PROBE=r'''
+import json,os,pathlib,shutil,subprocess,sys
+sys.path.insert(0,'/probe');import jvm_runner as runner
+p=pathlib.Path('/work/probe');p.mkdir()
+shutil.copytree('/baseline/gradle',p/'gradle')
