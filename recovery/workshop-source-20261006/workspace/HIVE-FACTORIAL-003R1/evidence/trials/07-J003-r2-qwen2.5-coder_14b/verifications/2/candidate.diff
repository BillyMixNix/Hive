+    public <U> Observation<U> map(java.util.function.Function<? super T, ? extends U> mapper) {
+        if (mapper == null) {
+            throw new IllegalArgumentException("Mapper cannot be null");
+        }
+        if (this.status != CapabilityStatus.AVAILABLE) {
+            return new Observation<>(this.status, null, this.detail);
+        }
+        U mappedData = mapper.apply(this.data);
+        if (mappedData == null) {
+            throw new IllegalArgumentException("Mapped result cannot be null");
+        }
+        return new Observation<>(CapabilityStatus.AVAILABLE, mappedData, this.detail);
+    }
