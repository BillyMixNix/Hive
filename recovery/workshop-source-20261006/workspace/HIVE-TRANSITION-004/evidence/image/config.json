{
  "User": "65532:65532",
  "Env": [
    "PATH=/opt/verifier-venv/bin:/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "JAVA_HOME=/opt/java/openjdk",
    "LANG=en_US.UTF-8",
    "LANGUAGE=en_US:en",
    "LC_ALL=en_US.UTF-8",
    "JAVA_VERSION=jdk-21.0.12.1+1",
    "PIP_DISABLE_PIP_VERSION_CHECK=1",
    "PYTHONDONTWRITEBYTECODE=1",
    "PYTHONUNBUFFERED=1"
  ],
  "Entrypoint": [
    "python3",
    "/opt/verifier/runner.py"
  ],
  "Labels": {
    "org.opencontainers.image.version": "22.04"
  }
}
