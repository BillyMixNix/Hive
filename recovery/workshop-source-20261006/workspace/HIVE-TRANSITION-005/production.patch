+def _targeted_diagnostic(verification: dict) -> str:
+    """Prioritize emitted results over logs, without cutting serialized JSON.
+
+    This is prompt transport only. The complete verifier result remains in the
+    run evidence and remains authoritative for acceptance.
+    """
+    def bounded(value, limit):
+        if isinstance(value, str):
+            return value if len(value) <= limit else "[earlier text omitted] " + value[-limit:]
+        if isinstance(value, list):
+            rows = [bounded(item, limit) for item in value[:8]]
+            if len(value) > 8:
+                rows.append({"omitted_items": len(value) - 8})
+            return rows
+        if isinstance(value, dict):
+            return {key: bounded(item, limit) for key, item in value.items()}
+        return value
+
+    checks = verification.get("checks", [])
+    payload = {"passed": verification.get("passed"), "checks": []}
+    if verification.get("error"):
+        payload["error"] = verification["error"]
+    # Failed checks take precedence under the existing bounded prompt budget.
+    ordered = sorted(checks, key=lambda item: item.get("passed") is True)
+    for check in ordered[:8]:
+        detail = check.get("detail")
+        row = {"name": check.get("name"), "passed": check.get("passed")}
+        if isinstance(detail, dict):
+            row["detail"] = {key: detail[key] for key in
+                ("returncode", "timed_out", "tests", "acceptance_mismatches", "error",
+                 "report_error", "reported_test_failures", "wall_seconds")
+                if key in detail}
+            for key in ("stdout_tail", "stderr_tail"):
+                if key in detail:
+                    # Machine progress records are already preserved in evidence;
+                    # do not let source/classpath inventories bury failures.
+                    row["detail"][key] = "\n".join(line for line in str(detail[key]).splitlines()
+                        if not line.startswith(("HIVE_GRADLE_DIAGNOSTIC ", "HIVE_VERIFIER_EVENT ")))
+        else:
+            row["detail"] = detail
+        payload["checks"].append(row)
+    if len(ordered) > 8:
+        payload["omitted_checks"] = len(ordered) - 8
+    for limit in (1600, 800, 400, 200, 80):
+        result = bounded(payload, limit)
+        encoded = json.dumps(result, ensure_ascii=False)
+        if len(encoded) <= 6000:
+            return encoded
+    # Bounded check count plus explicit omission; never return broken JSON.
+    while len(encoded) > 6000 and result["checks"]:
+        result["checks"].pop()
+        result["omitted_checks"] = result.get("omitted_checks", 0) + 1
+        encoded = json.dumps(result, ensure_ascii=False)
+    return encoded
+
