      "test_class": "dev.atmcompanion.knowledge.IngredientAllocationSlotAcceptanceTest",
      "test_sha256": "ba419614ac0603345a1284cf6d7924d6a2c42bd00291c76c531d20ef81ae6372",
      "test_cases": 3
    },
    {
      "id": "J003",
      "request": "Add `Observation.map(java.util.function.Function<? super T, ? extends U>)` returning `Observation<U>`. For available data, apply the mapper exactly once and preserve status and detail; a null mapper or null mapped result must be rejected. For unavailable or not-integrated observations, preserve status and detail with null data and never invoke the mapper. Do not change the existing factories or constructor invariants.\n\nWrite scope: `src/main/java/dev/atmcompanion/state/Observation.java`.",
      "request_sha256": "c998c4994397681b7ff37deb972c562ba7d27f0aa8b06226865888e7825393b7",
      "files": [
