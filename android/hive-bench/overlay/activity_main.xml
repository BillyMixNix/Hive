<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hive_screen_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="36dp">

        <!-- Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="⬡"
                android:textColor="#26E4D6"
                android:textSize="42sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hive Mobile"
                    android:textColor="#F5FAFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Local AI  •  persistent state  •  no API key"
                    android:textColor="#8FB8CD"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Model card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/hive_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCAL MODEL"
                android:textColor="#28D7CE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/model_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="No model loaded"
                android:textColor="#F4F8FC"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Run Qwen locally and let Hive manage the state around it."
                android:textColor="#9FB2C4"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/select_model"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_teal"
                    android:gravity="center"
                    android:text="Select GGUF"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/model_page"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_outline"
                    android:gravity="center"
                    android:text="Get Qwen 3B"
                    android:textAllCaps="false"
                    android:textColor="#8DCCFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/hive_input"
                android:padding="11dp"
                android:textColor="#AFC0CE"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Primary destinations -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="WHAT DO YOU WANT TO DO?"
            android:textColor="#5D8CA8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/nav_chat"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_weight="1"
                android:background="@drawable/hive_card_teal"
                android:gravity="center"
                android:text="Chat\nTalk with Hive"
                android:textAllCaps="false"
                android:textColor="#F4FFFE"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nav_work"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/hive_card_blue"
                android:gravity="center"
                android:text="Work\nPlan + change code"
                android:textAllCaps="false"
                android:textColor="#F4FAFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/nav_diag"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/hive_button_outline"
            android:text="Diagnostics  •  Raw vs Hive  •  Throughput"
            android:textAllCaps="false"
            android:textColor="#8FB8CD"
            android:textSize="13sp" />

        <!-- CHAT -->
        <LinearLayout
            android:id="@+id/chat_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/hive_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#F5FAFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Conversation stays human-readable. Hive state stays separate."
                android:textColor="#87A1B4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hive_state_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_card_teal"
                android:padding="12dp"
                android:text="Hive state: empty"
                android:textColor="#8EF4EC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_input"
                android:minHeight="230dp"
                android:padding="14dp"
                android:textColor="#DFE8EF"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_input"
                android:gravity="top|start"
                android:hint="Message Hive…"
                android:hintTextColor="#577083"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6"
                android:minLines="2"
                android:textColor="#F1F6FA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/send_chat"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_teal"
                    android:text="Send"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/clear_chat"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_outline"
                    android:text="Clear chat"
                    android:textAllCaps="false"
                    android:textColor="#A6B9C8" />
            </LinearLayout>
        </LinearLayout>

        <!-- WORK -->
        <LinearLayout
            android:id="@+id/work_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/hive_card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Work"
                android:textColor="#F5FAFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Import a project, describe the task, review the change, then approve it."
                android:textColor="#87A1B4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/project_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_card_blue"
                android:padding="13dp"
                android:text="No workspace imported"
                android:textColor="#B7DDFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/import_zip"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_teal"
                    android:text="Import project ZIP"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/export_zip"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_outline"
                    android:enabled="false"
                    android:text="Export workspace"
                    android:textAllCaps="false"
                    android:textColor="#8DCCFF" />
            </LinearLayout>

            <EditText
                android:id="@+id/task_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_input"
                android:gravity="top|start"
                android:hint="Describe the work in normal English…"
                android:hintTextColor="#577083"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="7"
                android:minLines="3"
                android:textColor="#F1F6FA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/plan_task"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_outline"
                    android:text="1. Plan"
                    android:textAllCaps="false"
                    android:textColor="#82D7FF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/propose_change"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_teal"
                    android:enabled="false"
                    android:text="2. Propose change"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/work_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_input"
                android:fontFamily="monospace"
                android:minHeight="180dp"
                android:padding="14dp"
                android:textColor="#D7E3EC"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/apply_change"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_teal"
                    android:enabled="false"
                    android:text="Approve + apply"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/reject_change"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_outline"
                    android:enabled="false"
                    android:text="Reject"
                    android:textAllCaps="false"
                    android:textColor="#FFB1B8" />
            </LinearLayout>

            <Button
                android:id="@+id/clear_workspace"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/hive_button_outline"
                android:text="Clear workspace"
                android:textAllCaps="false"
                android:textColor="#8095A6" />
        </LinearLayout>

        <!-- DIAGNOSTICS -->
        <LinearLayout
            android:id="@+id/diag_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/hive_card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diagnostics"
                android:textColor="#F5FAFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Benchmark the same local model with raw context and Hive state."
                android:textColor="#87A1B4"
                android:textSize="12sp" />

            <Button
                android:id="@+id/throughput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_card_blue"
                android:text="Run device throughput"
                android:textAllCaps="false"
                android:textColor="#9ED5FF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="FAIR RAW VS HIVE A/B"
                android:textColor="#27D8CF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button android:id="@+id/run_8k" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:text="8k" android:textAllCaps="false" android:textColor="#AFC3D2" />
                <Button android:id="@+id/run_16k" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:text="16k" android:textAllCaps="false" android:textColor="#AFC3D2" />
                <Button android:id="@+id/run_24k" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:text="24k" android:textAllCaps="false" android:textColor="#AFC3D2" />
                <Button android:id="@+id/run_30k" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:text="30k" android:textAllCaps="false" android:textColor="#AFC3D2" />
            </LinearLayout>

            <Button
                android:id="@+id/run_all"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/hive_button_teal"
                android:text="Run all Raw vs Hive"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cancel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_outline"
                    android:enabled="false"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#FFB1B8" />

                <Button
                    android:id="@+id/share"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/hive_button_outline"
                    android:enabled="false"
                    android:text="Share JSON"
                    android:textAllCaps="false"
                    android:textColor="#8DCCFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/hive_input"
                android:fontFamily="monospace"
                android:minHeight="140dp"
                android:padding="14dp"
                android:textColor="#D7E3EC"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="#20D9CF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/run_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#7FA0B5"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
