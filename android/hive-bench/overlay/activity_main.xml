<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hive_screen_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/screen_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/home_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="28dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="58dp" android:layout_height="58dp" android:gravity="center" android:text="⬡" android:textColor="#2AF0DF" android:textSize="46sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hive Mobile" android:textColor="#F7FAFF" android:textSize="31sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Local AI + persistent state" android:textColor="#8DB6CB" android:textSize="13sp" />
                    </LinearLayout>
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/hive_button_outline" android:gravity="center" android:text="⚙" android:textColor="#B8C7D4" android:textSize="22sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/hive_card" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL MODEL" android:textColor="#2BE3D6" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/model_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="No model loaded" android:textColor="#F6F9FC" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Run the model locally. Hive owns the durable state around it." android:textColor="#90A7B9" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                        <Button android:id="@+id/select_model" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/hive_button_teal" android:backgroundTint="@null" android:text="Select GGUF" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
                        <Button android:id="@+id/model_page" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="Get Qwen 3B" android:textAllCaps="false" android:textColor="#8CCBFF" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/device_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_input" android:padding="11dp" android:textColor="#A9BBC8" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/home_chat_card" android:layout_width="0dp" android:layout_height="132dp" android:layout_weight="1" android:background="@drawable/hive_card_teal" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/hive_button_teal" android:gravity="center" android:text="●" android:textColor="#E8FFFC" android:textSize="17sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Chat" android:textColor="#F8FFFF" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Talk with your local AI" android:textColor="#9CC9C6" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/home_work_card" android:layout_width="0dp" android:layout_height="132dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/hive_card_blue" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/hive_button_outline" android:gravity="center" android:text="◆" android:textColor="#8CCBFF" android:textSize="17sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Work" android:textColor="#F6FAFF" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Plan, review, change code" android:textColor="#9EBAD0" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="10dp" android:background="@drawable/hive_card" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/home_memory_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Memory" android:textColor="#F4F9FC" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="State + exact sources" android:textColor="#79BDB8" android:textSize="11sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:background="#20384A" />
                    <LinearLayout android:id="@+id/nav_diag" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diagnostics" android:textColor="#F4F9FC" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Health + Raw vs Hive" android:textColor="#7EB7E2" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT PROJECT" android:textColor="#2BDDD2" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/home_project_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="No project loaded\nOpen Work to import a project" android:textColor="#F4F8FC" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RECENT ACTIVITY" android:textColor="#5D91AA" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/home_recent_activity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No activity yet" android:textColor="#B5C4CF" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/chat_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chat" android:textColor="#F7FAFF" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Conversation stays human-readable. Hive state stays separate." android:textColor="#849EB0" android:textSize="12sp" />
                <TextView android:id="@+id/hive_state_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/hive_card_teal" android:padding="12dp" android:textColor="#8AF2E9" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/chat_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_card" android:minHeight="360dp" android:padding="15dp" android:textColor="#E0E8EF" android:textIsSelectable="true" android:textSize="14sp" />
                <EditText android:id="@+id/chat_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_input" android:gravity="top|start" android:hint="Message Hive…" android:inputType="textCapSentences|textMultiLine" android:maxLines="6" android:minLines="2" android:padding="14dp" android:textColor="#F3F7FA" android:textColorHint="#587083" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/send_chat" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/hive_button_teal" android:backgroundTint="@null" android:text="Send" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <Button android:id="@+id/clear_chat" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="Clear" android:textAllCaps="false" android:textColor="#A9B8C4" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/work_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Work" android:textColor="#F7FAFF" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/project_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_card_blue" android:padding="14dp" android:textColor="#B6DCFF" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/import_zip" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/hive_button_teal" android:backgroundTint="@null" android:text="Import project" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <Button android:id="@+id/export_zip" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:enabled="false" android:text="Export" android:textAllCaps="false" android:textColor="#8DCBFF" />
                </LinearLayout>
                <EditText android:id="@+id/task_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_input" android:gravity="top|start" android:hint="Describe the work in normal English…" android:inputType="textCapSentences|textMultiLine" android:maxLines="7" android:minLines="3" android:padding="14dp" android:textColor="#F3F7FA" android:textColorHint="#587083" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/plan_task" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="1. Plan" android:textAllCaps="false" android:textColor="#83D7FF" android:textStyle="bold" />
                    <Button android:id="@+id/propose_change" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/hive_button_teal" android:backgroundTint="@null" android:enabled="false" android:text="2. Propose" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/work_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_card" android:fontFamily="monospace" android:minHeight="230dp" android:padding="14dp" android:textColor="#D9E3EB" android:textIsSelectable="true" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/apply_change" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/hive_button_teal" android:backgroundTint="@null" android:enabled="false" android:text="Approve + apply" android:textAllCaps="false" android:textColor="#FFFFFF" />
                    <Button android:id="@+id/reject_change" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:enabled="false" android:text="Reject" android:textAllCaps="false" android:textColor="#FFB4BA" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/undo_change" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:enabled="false" android:text="Undo last change" android:textAllCaps="false" android:textColor="#8DCBFF" />
                    <Button android:id="@+id/clear_workspace" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="Clear workspace" android:textAllCaps="false" android:textColor="#8799A7" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/memory_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Memory" android:textColor="#F7FAFF" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Derived state is editable. Exact human source remains authoritative." android:textColor="#849EB0" android:textSize="12sp" />
                <EditText android:id="@+id/memory_state_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/hive_input" android:fontFamily="monospace" android:gravity="top|start" android:hint="{}" android:inputType="textMultiLine|textNoSuggestions" android:maxLines="15" android:minLines="8" android:padding="14dp" android:textColor="#DFF8F5" android:textColorHint="#587083" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/save_memory" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/hive_button_teal" android:backgroundTint="@null" android:text="Save" android:textAllCaps="false" android:textColor="#FFFFFF" />
                    <Button android:id="@+id/rebuild_memory" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="Rebuild" android:textAllCaps="false" android:textColor="#8DCBFF" />
                    <Button android:id="@+id/clear_memory" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="Clear" android:textAllCaps="false" android:textColor="#FFB4BA" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="SOURCE EVIDENCE" android:textColor="#5D91AA" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/memory_sources" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/hive_card" android:minHeight="220dp" android:padding="14dp" android:textColor="#B7C7D2" android:textIsSelectable="true" android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/diag_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Diagnostics" android:textColor="#F7FAFF" android:textSize="28sp" android:textStyle="bold" />
                <Button android:id="@+id/throughput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="Run device throughput" android:textAllCaps="false" android:textColor="#8DCBFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="RAW VS HIVE" android:textColor="#5D91AA" android:textSize="10sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/run_8k" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="8k" android:textAllCaps="false" android:textColor="#B9CAD6" />
                    <Button android:id="@+id/run_16k" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="16k" android:textAllCaps="false" android:textColor="#B9CAD6" />
                    <Button android:id="@+id/run_24k" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="24k" android:textAllCaps="false" android:textColor="#B9CAD6" />
                    <Button android:id="@+id/run_30k" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:text="30k" android:textAllCaps="false" android:textColor="#B9CAD6" />
                </LinearLayout>
                <Button android:id="@+id/run_all" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/hive_button_teal" android:backgroundTint="@null" android:text="Run all Raw vs Hive" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/cancel" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:enabled="false" android:text="Cancel" android:textAllCaps="false" android:textColor="#FFB4BA" />
                    <Button android:id="@+id/share" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/hive_button_outline" android:backgroundTint="@null" android:enabled="false" android:text="Share JSON" android:textAllCaps="false" android:textColor="#8DCBFF" />
                </LinearLayout>
                <TextView android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/hive_card" android:fontFamily="monospace" android:minHeight="220dp" android:padding="14dp" android:textColor="#C7D6E0" android:textIsSelectable="true" android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#E6050A11" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="5dp" android:paddingEnd="14dp" android:paddingBottom="5dp">
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleSmall" android:layout_width="22dp" android:layout_height="22dp" android:visibility="gone" />
        <TextView android:id="@+id/run_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:maxLines="2" android:textColor="#7FA1B5" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:background="@drawable/hive_card" android:gravity="center" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textColor="#2BE3D6" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/nav_chat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="●\nChat" android:textColor="#8296A6" android:textSize="11sp" />
        <TextView android:id="@+id/nav_work" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◆\nWork" android:textColor="#8296A6" android:textSize="11sp" />
        <TextView android:id="@+id/nav_memory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◉\nMemory" android:textColor="#8296A6" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
